DB_URL=jdbc:mysql://localhost:3306/chat_application?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

GG_CLIENT_ID=your-google-client-id
GG_CLIENT_SECRET=your-google-client-secret

# HS256 keys must contain at least 32 random bytes.
JWT_ACCESS_KEY=replace-with-a-long-random-access-secret
JWT_REFRESH_KEY=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Image uploads are authenticated by the monolith. Never expose API_SECRET to React.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=luma-chat
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_FILE_SIZE=10MB

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
